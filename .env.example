APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3001
# Javna (produkciona) adresa React dashboard-a
FRONTEND_URL_PUBLIC=https://dashboard.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ebiblioteka_new
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Zajednički cookie domen za deljenje sesije između poddomena; prazno = host-only
SESSION_COOKIE_DOMAIN_PUBLIC=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3001,127.0.0.1,127.0.0.1:3001,react-frontend,localhost:81

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@ebiblioteka.rs"
MAIL_FROM_NAME="eBiblioteka"
# Mailer za transakcione mejlove (reset lozinke, novi nalog, kontakt forma).
# Na dev/develop okruženju držite "log" (upisuje u storage/logs), za stvarno
# slanje postavite "postmark".
MAIL_TRANSACTIONAL_MAILER=log
# Mailer za marketing/masovne mejlove (budući Mailgun za newsletter)
MAIL_MARKETING_MAILER=postmark
POSTMARK_API_KEY=
# E-mail primalac forme za kontakt sa javnog portala.
# Za više primalaca odvojiti zarezom (obavezno pod navodnicima):
# CONTACT_EMAIL="prvi@example.com, drugi@example.com"
CONTACT_EMAIL=

# Cloudflare Turnstile zaštita kontakt forme (Managed mode).
# Site key koristi frontend (javna vrednost), secret isključivo Laravel.
# Vrednosti se podešavaju u Cloudflare dashboardu (Turnstile widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Frontend hostname-i dozvoljeni za Turnstile siteverify (razdvojeni zarezom).
# U produkciji NAVEDITE stvarni domen (npr. demo.ebiblioteka.rs) — nikada
# localhost/127.0.0.1. Prazno = provera hostname-a isključena (lokalni razvoj).
TURNSTILE_HOSTNAMES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ISBN metadata lookup (NBS/COBISS+ scraping -> Open Library -> Google Books).
# Google Books radi i bez kljuca (ogranicena kvota); kljuc je opciona.
GOOGLE_BOOKS_API_KEY=
ISBN_HTTP_TIMEOUT=8
ISBN_CACHE_TTL=86400
# Identifikacija ka eksternim izvorima (Open Library/Google Books/NBS).
ISBN_USER_AGENT="eBiblioteka/1.0 (+mailto:akademijafilipovic@gmail.com)"
# Prevod naziva kategorija iz provajdera na srpski (besplatni Google Translate klijent).
ISBN_TRANSLATE_ENABLED=true
ISBN_TRANSLATE_TARGET=sr
ISBN_TRANSLATE_CACHE_TTL=604800
# NBS/COBISS+ scraping (primarni izvor; postuje robots.txt Crawl-delay 1).
NBS_CATALOG_ENABLED=false
NBS_CATALOG_SEARCH_URL=https://plus-legacy.cobiss.net/cobiss/sr/sr/bib/search
NBS_CATALOG_QUERY_PARAM=q
NBS_CATALOG_DATABASE=cobib
NBS_CATALOG_MATERIAL=allmaterials
NBS_CATALOG_BASE_URL=https://plus-legacy.cobiss.net/cobiss/sr/sr/
NBS_CATALOG_MAX_RESULTS=3
NBS_CATALOG_CRAWL_DELAY=1

VITE_APP_NAME="${APP_NAME}"
